{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/**,migrations/**,lib/**,routes/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
